<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>fl — файлы</title>
<style>
  :root{
    --bg:#0d1117;
    --card:#0f1720;
    --muted:#8b949e;
    --accent:#58a6ff;
  }
  html,body{height:100%;margin:0;background:var(--bg);color:#e6edf3;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial;}
  .wrap{max-width:760px;margin:28px auto;padding:16px}
  header{font-weight:600;margin-bottom:12px;text-align:left;font-size:18px}
  ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
  li{
    background:var(--card);
    border:1px solid rgba(255,255,255,0.03);
    padding:12px 14px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    cursor:pointer;
    transition:transform .08s ease, background .12s;
    user-select:none;
    overflow:hidden;
    white-space:nowrap;
    text-overflow:ellipsis;
  }
  li:active{transform:scale(.998)}
  .name{flex:1;overflow:hidden;text-overflow:ellipsis}
  .hint{font-size:13px;color:var(--muted);margin-top:10px}
  .copy-confirm{position:fixed;left:50%;transform:translateX(-50%);bottom:28px;background:#16272a;padding:8px 12px;border-radius:10px;border:1px solid rgba(255,255,255,0.04);font-size:13px}
  a.download-link{display:block;width:100%;height:100%;text-decoration:none;color:inherit}
</style>
</head>
<body>
  <div class="wrap">
    <div header><span style="font-size:18px;font-weight:600">📁 fl</span></div>
    <ul id="list"><li class="name">Загрузка...</li></ul>
    <div class="hint">Клик — скачать · ПКМ / долгое нажатие — скопировать ссылку</div>
  </div>

  <script>
  (async function(){
    const listEl = document.getElementById('list');

    function showConfirm(text){
      const el = document.createElement('div');
      el.className = 'copy-confirm';
      el.textContent = text;
      document.body.appendChild(el);
      setTimeout(()=> el.remove(), 1100);
    }

    try{
      const res = await fetch('/fl/');
      const html = await res.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      // Получаем относительные ссылки на файлы (без папок)
      const links = Array.from(doc.querySelectorAll('a'))
        .map(a => a.getAttribute('href'))
        .filter(h => h && !h.endsWith('/') && !h.startsWith('?') && !h.startsWith('/'));

      if(!links.length){
        listEl.innerHTML = '<li style="cursor:default">Папка пуста</li>';
        return;
      }

      listEl.innerHTML = '';
      links.forEach(name=>{
        const li = document.createElement('li');
        const span = document.createElement('span');
        span.className = 'name';
        span.textContent = name;

        // ссылка для скачивания
        const link = document.createElement('a');
        link.className = 'download-link';
        // полный путь
        const fileUrl = location.origin + '/fl/' + encodeURIComponent(name);
        link.href = fileUrl;
        link.setAttribute('download', name);
        link.appendChild(span);
        li.appendChild(link);

        // клик по li (если кликнули вне <a>) — открываем в новом табе (тоже скачает)
        li.addEventListener('click', (e)=>{
          // если клик по ссылке — норм
          if(e.target.closest('a')) return;
          window.open(fileUrl, '_blank');
        });

        // ПКМ — копировать ссылку
        li.addEventListener('contextmenu', (e)=>{
          e.preventDefault();
          navigator.clipboard?.writeText(fileUrl).then(()=> showConfirm('Ссылка скопирована'));
        });

        // long-press для тачей
        let timer = null;
        li.addEventListener('touchstart', ()=>{
          timer = setTimeout(()=>{
            navigator.clipboard?.writeText(fileUrl).then(()=> showConfirm('Ссылка скопирована'));
          }, 600);
        });
        li.addEventListener('touchend', ()=> { if(timer) clearTimeout(timer); });

        listEl.appendChild(li);
      });

    }catch(err){
      listEl.innerHTML = '<li style="cursor:default">Ошибка загрузки</li>';
      console.error(err);
    }
  })();
  </script>
</body>
</html>